{% extends '@Tailsfadmin/layout/admin.html.twig' %}

{% block title %}Page vierge — tailsfadmin{% endblock %}

{% block breadcrumb %}
    <twig:tsf:Layout:Breadcrumb pageName="Page vierge" />
{% endblock %}

{#
    US-023 — Gabarit vierge. Point de départ minimal pour une nouvelle page :
    hérite du layout admin (sidebar + header + breadcrumb) et fournit une carte vide.
#}

{% block content %}
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] lg:p-6">
        <div class="mx-auto max-w-md text-center">
            <h3 class="mb-3 text-lg font-semibold text-gray-800 dark:text-white/90">Page vierge</h3>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                Ce gabarit vide hérite du layout admin. Utilisez-le comme point de départ
                pour construire une nouvelle page en y insérant vos composants tsf.
            </p>
        </div>
    </div>
{% endblock %}
