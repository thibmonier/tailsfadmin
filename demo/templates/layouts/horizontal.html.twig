{% extends '@Tailsfadmin/layout/admin.html.twig' %}

{% block title %}Layout — {{ meta.label }} — tailsfadmin{% endblock %}

{% block breadcrumb %}
    <twig:tsf:Layout:Breadcrumb pageName="Layout : {{ meta.label }}" />
{% endblock %}

{# Variante 3 — navigation horizontale : pas de sidebar, menu dans l'en-tête.
   La structure de menu est réutilisée depuis MenuBuilder (menuGroups). #}
{% block sidebar %}{% endblock %}

{# Pas de sidebar → on retire son contrôleur Stimulus du wrapper (aucune cible). #}
{% block layout_shell_attributes %}{% endblock %}

{% block header %}
    <header class="sticky top-0 z-99999 flex w-full border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
        <div class="flex w-full items-center gap-6 px-4 py-3 lg:px-6">
            <a href="{{ path('home') }}" class="shrink-0 font-outfit text-xl font-bold text-brand-500">tailsfadmin</a>
            <nav data-testid="horizontal-nav" aria-label="Navigation principale" class="flex flex-wrap items-center gap-1 overflow-x-auto">
                {% for group in menuGroups %}
                    {% for item in group.items %}
                        <a
                            href="{{ item.path }}"
                            class="rounded-lg px-3 py-2 text-sm font-medium transition {{ is_active(item.path)
                                ? 'bg-brand-50 text-brand-600 dark:bg-brand-500/10'
                                : 'text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/[0.05]' }}"
                            {{ is_active(item.path) ? 'aria-current="page"' : '' }}
                        >{{ item.label|trans }}</a>
                    {% endfor %}
                {% endfor %}
            </nav>
        </div>
    </header>
{% endblock %}

{% block content %}{% include 'layouts/_demo_content.html.twig' %}{% endblock %}
