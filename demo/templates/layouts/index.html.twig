{% extends '@Tailsfadmin/layout/admin.html.twig' %}

{% block title %}Variantes de layout — tailsfadmin{% endblock %}

{% block breadcrumb %}
    <twig:tsf:Layout:Breadcrumb pageName="Layouts" />
{% endblock %}

{# US-037 — Index des 6 variantes d'agencement. #}

{% block content %}
    <div class="space-y-5">
        <p class="text-sm text-gray-500 dark:text-gray-400">
            Six agencements du shell admin, chacun obtenu par simple surcharge de blocs
            du layout du bundle (aucune duplication). Choisissez-en un pour le prévisualiser.
        </p>

        <div data-testid="layouts-index" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {% for slug, variant in variants %}
                <a
                    href="{{ path('layouts_show', {variant: slug}) }}"
                    data-testid="layout-card"
                    class="block rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-theme-md dark:border-gray-800 dark:bg-white/[0.03] dark:hover:border-brand-800"
                >
                    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">{{ variant.label }}</h3>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ variant.desc }}</p>
                    <span class="mt-3 inline-flex text-sm font-medium text-brand-500">Prévisualiser →</span>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock %}
