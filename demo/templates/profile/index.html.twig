{% extends '@Tailsfadmin/layout/admin.html.twig' %}

{% block title %}Profil — tailsfadmin{% endblock %}

{% block breadcrumb %}
    <twig:tsf:Layout:Breadcrumb pageName="Profil" />
{% endblock %}

{#
    US-022 — Page profil + modales d'édition.
    Réutilise tsf:Ui:Avatar, tsf:Ui:Modal (US-011), tsf:Ui:Button, tsf:Form:* (US-014).
    Données : ProfileController (fixtures de démo, ADR-002 ; POST → PRG sans persistance).
#}

{% set pencilIcon %}<svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.083 12.66l7.663-7.664 2.35 2.35-7.663 7.663-2.756.407.406-2.756z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}

{% block content %}
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] lg:p-6">
        <h3 class="mb-6 text-lg font-semibold text-gray-800 dark:text-white/90">Mon profil</h3>

        {# ─── Carte méta : avatar + identité + réseaux sociaux ─── #}
        <div class="mb-6 rounded-2xl border border-gray-200 p-5 dark:border-gray-800 lg:p-6">
            <div class="flex flex-col items-center gap-6 xl:flex-row xl:justify-between">
                <div class="flex flex-col items-center gap-6 xl:flex-row">
                    <twig:tsf:Ui:Avatar alt="{{ user.firstName }} {{ user.lastName }}" size="2xl" />
                    <div class="text-center xl:text-left">
                        <h4 class="mb-1 text-title-sm font-semibold text-gray-800 dark:text-white/90">
                            {{ user.firstName }} {{ user.lastName }}
                        </h4>
                        <div class="flex flex-col items-center gap-1 xl:flex-row xl:gap-3">
                            <span class="text-theme-sm text-gray-500 dark:text-gray-400">{{ user.role }}</span>
                            <span class="hidden h-3.5 w-px bg-gray-300 dark:bg-gray-700 xl:block"></span>
                            <span class="text-theme-sm text-gray-500 dark:text-gray-400">{{ user.location }}</span>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    {% for network, url in user.social %}
                        <a
                            href="{{ url }}"
                            target="_blank"
                            rel="noopener"
                            aria-label="{{ network|capitalize }}"
                            class="flex size-10 items-center justify-center rounded-full border border-gray-200 text-gray-500 transition hover:bg-gray-50 hover:text-gray-800 dark:border-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03] dark:hover:text-white/90"
                        >
                            <span class="text-theme-xs font-semibold uppercase">{{ network|slice(0, 2) }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# ─── Informations personnelles + modale d'édition ─── #}
        <div class="mb-6 rounded-2xl border border-gray-200 p-5 dark:border-gray-800 lg:p-6">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                <div class="w-full">
                    <h4 class="mb-6 text-lg font-semibold text-gray-800 dark:text-white/90">Informations personnelles</h4>
                    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-7">
                        {% set infoFields = [
                            { k: 'Prénom', v: user.firstName },
                            { k: 'Nom', v: user.lastName },
                            { k: 'Adresse e-mail', v: user.email },
                            { k: 'Téléphone', v: user.phone },
                            { k: 'Bio', v: user.bio },
                        ] %}
                        {% for f in infoFields %}
                            <div>
                                <p class="mb-2 text-theme-xs text-gray-500 dark:text-gray-400">{{ f.k }}</p>
                                <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">{{ f.v }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <twig:tsf:Ui:Modal size="lg" labelId="modal-info-title">
                    <twig:block name="trigger">
                        <twig:tsf:Ui:Button variant="secondary" :iconStart="pencilIcon">Modifier</twig:tsf:Ui:Button>
                    </twig:block>
                    <twig:block name="header">
                        <h4 id="modal-info-title" class="text-lg font-semibold text-gray-800 dark:text-white/90">
                            Modifier les informations personnelles
                        </h4>
                        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">
                            Mettez à jour vos informations pour garder votre profil à jour.
                        </p>
                    </twig:block>
                    <twig:block name="body">
                        <form method="post" action="{{ path('profile') }}">
                            <div class="grid grid-cols-1 gap-x-6 gap-y-5 lg:grid-cols-2">
                                <twig:tsf:Form:Input label="Prénom" name="first_name" :value="user.firstName" />
                                <twig:tsf:Form:Input label="Nom" name="last_name" :value="user.lastName" />
                                <twig:tsf:Form:Input label="Adresse e-mail" name="email" type="email" :value="user.email" />
                                <twig:tsf:Form:Input label="Téléphone" name="phone" type="tel" :value="user.phone" />
                                <div class="lg:col-span-2">
                                    <twig:tsf:Form:Textarea label="Bio" name="bio" :rows="4" :value="user.bio" />
                                </div>
                                <twig:tsf:Form:Input label="Facebook" name="facebook" type="url" :value="user.social.facebook" />
                                <twig:tsf:Form:Input label="X.com" name="x" type="url" :value="user.social.x" />
                                <twig:tsf:Form:Input label="LinkedIn" name="linkedin" type="url" :value="user.social.linkedin" />
                                <twig:tsf:Form:Input label="Instagram" name="instagram" type="url" :value="user.social.instagram" />
                            </div>
                            {% include 'profile/_modal_actions.html.twig' %}
                        </form>
                    </twig:block>
                </twig:tsf:Ui:Modal>
            </div>
        </div>

        {# ─── Adresse + modale d'édition ─── #}
        <div class="rounded-2xl border border-gray-200 p-5 dark:border-gray-800 lg:p-6">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                <div class="w-full">
                    <h4 class="mb-6 text-lg font-semibold text-gray-800 dark:text-white/90">Adresse</h4>
                    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-7">
                        {% set addressFields = [
                            { k: 'Pays', v: address.country },
                            { k: 'Ville / Région', v: address.cityState },
                            { k: 'Code postal', v: address.postalCode },
                            { k: 'Numéro fiscal', v: address.taxId },
                        ] %}
                        {% for f in addressFields %}
                            <div>
                                <p class="mb-2 text-theme-xs text-gray-500 dark:text-gray-400">{{ f.k }}</p>
                                <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">{{ f.v }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <twig:tsf:Ui:Modal size="lg" labelId="modal-address-title">
                    <twig:block name="trigger">
                        <twig:tsf:Ui:Button variant="secondary" :iconStart="pencilIcon">Modifier</twig:tsf:Ui:Button>
                    </twig:block>
                    <twig:block name="header">
                        <h4 id="modal-address-title" class="text-lg font-semibold text-gray-800 dark:text-white/90">
                            Modifier l'adresse
                        </h4>
                        <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">
                            Mettez à jour vos coordonnées postales.
                        </p>
                    </twig:block>
                    <twig:block name="body">
                        <form method="post" action="{{ path('profile') }}">
                            <div class="grid grid-cols-1 gap-x-6 gap-y-5 lg:grid-cols-2">
                                <twig:tsf:Form:Input label="Pays" name="country" :value="address.country" />
                                <twig:tsf:Form:Input label="Ville / Région" name="city_state" :value="address.cityState" />
                                <twig:tsf:Form:Input label="Code postal" name="postal_code" :value="address.postalCode" />
                                <twig:tsf:Form:Input label="Numéro fiscal" name="tax_id" :value="address.taxId" />
                            </div>
                            {% include 'profile/_modal_actions.html.twig' %}
                        </form>
                    </twig:block>
                </twig:tsf:Ui:Modal>
            </div>
        </div>
    </div>
{% endblock %}
