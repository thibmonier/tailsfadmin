{% extends '@Tailsfadmin/layout/admin.html.twig' %}
{% import 'dashboards/_macros.html.twig' as dash %}

{% block title %}Dashboard {{ meta.label }} — tailsfadmin{% endblock %}
{% block breadcrumb %}<twig:tsf:Layout:Breadcrumb pageName="Dashboard {{ meta.label }}" />{% endblock %}

{% block content %}
    <div class="space-y-6">
        {{ dash.kpi_grid(kpis) }}

        <div class="grid grid-cols-12 gap-4 md:gap-6">
            <div class="col-span-12 xl:col-span-7">
                <twig:tsf:Ui:Card title="Performance des campagnes" subtitle="Clics par campagne">
                    <twig:block name="body">
                        <twig:tsf:Chart:Bar :series="campaignSeries" :categories="campaignLabels" :height="300" />
                    </twig:block>
                </twig:tsf:Ui:Card>
            </div>
            <div class="col-span-12 xl:col-span-5">
                <twig:tsf:Ui:Card title="Budget par canal" subtitle="Consommation du budget">
                    <twig:block name="body">
                        <div class="space-y-5">
                            {% for c in channels %}
                                <twig:tsf:Ui:ProgressBar :value="c.value" variant="{{ c.variant }}" showValue label="{{ c.label }}" />
                            {% endfor %}
                        </div>
                    </twig:block>
                </twig:tsf:Ui:Card>
            </div>
        </div>
    </div>
{% endblock %}
