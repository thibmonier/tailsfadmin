{% extends '@Tailsfadmin/layout/admin.html.twig' %}

{% block title %}Dashboards métier — tailsfadmin{% endblock %}
{% block breadcrumb %}<twig:tsf:Layout:Breadcrumb pageName="Dashboards" />{% endblock %}

{% block content %}
    <div class="space-y-5">
        <p class="text-sm text-gray-500 dark:text-gray-400">
            Quatre tableaux de bord métier prêts à copier, assemblés depuis les composants
            du bundle (KPI, graphiques, tables, badges). Choisissez un domaine.
        </p>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {% for slug, dashboard in dashboards %}
                <a
                    href="{{ path('dashboard_' ~ slug) }}"
                    data-testid="dashboard-card"
                    class="block rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-theme-md dark:border-gray-800 dark:bg-white/[0.03] dark:hover:border-brand-800"
                >
                    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">{{ dashboard.label }}</h3>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ dashboard.desc }}</p>
                    <span class="mt-3 inline-flex text-sm font-medium text-brand-500">Ouvrir →</span>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock %}
