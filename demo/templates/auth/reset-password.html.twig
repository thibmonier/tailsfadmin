{% extends '@Tailsfadmin/layout/auth.html.twig' %}

{% block title %}Mot de passe oublié — tailsfadmin{% endblock %}

{# US-034 — Demande de réinitialisation (UI de démo). #}

{% block content %}
    <div class="w-full max-w-md pt-6">
        <a href="{{ path('auth_login') }}" class="inline-flex items-center gap-1 text-theme-sm text-gray-500 transition hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300">
            <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 15l-5-5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Retour à la connexion
        </a>
    </div>

    <div class="mb-5 sm:mb-8">
        <h1 class="mb-2 text-title-sm font-semibold text-gray-800 dark:text-white/90 sm:text-title-md">Mot de passe oublié ?</h1>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">
            Saisissez votre e-mail : nous vous enverrons un lien de réinitialisation.
        </p>
    </div>

    <form method="post" action="{{ path('auth_reset') }}" class="space-y-5">
        <twig:tsf:Form:Input label="E-mail" name="email" type="email" placeholder="info@exemple.fr" :required="true" />
        <twig:tsf:Ui:Button variant="primary" size="lg" type="submit" :block="true">Envoyer le lien</twig:tsf:Ui:Button>
    </form>

    <p class="mt-5 text-center text-theme-sm text-gray-500 dark:text-gray-400">
        Vous vous souvenez de votre mot de passe ?
        <a href="{{ path('auth_login') }}" class="font-medium text-brand-500 hover:text-brand-600">Se connecter</a>
    </p>
{% endblock %}
