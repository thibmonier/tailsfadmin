{% extends '@Tailsfadmin/layout/admin.html.twig' %}

{% block title %}Dashboard — tailsfadmin{% endblock %}

{% block breadcrumb %}
    <twig:tsf:Layout:Breadcrumb pageName="Dashboard" />
{% endblock %}

{% block content %}
    <div class="max-w-2xl">
        <p class="mt-4 text-theme-sm text-gray-500">
            Application de démo du bundle <strong class="text-gray-700">tailsfadmin</strong> —
            thème admin Symfony basé sur TailAdmin.
        </p>

        {# Classes utilitaires brand prouvant le pipeline Tailwind v4 (T-002-05) #}
        <div class="mt-6 flex flex-wrap gap-4">
            <span class="inline-block px-4 py-2 bg-brand-500 text-white rounded-lg text-theme-sm font-medium">
                bg-brand-500 (#465fff)
            </span>
            <span class="inline-block px-4 py-2 bg-success-500 text-white rounded-lg text-theme-sm font-medium">
                bg-success-500
            </span>
            <span class="inline-block px-4 py-2 bg-error-500 text-white rounded-lg text-theme-sm font-medium">
                bg-error-500
            </span>
        </div>

        <p class="mt-4 text-theme-xs text-gray-400">
            Sprint 1 — Walking Skeleton · US-004 : layout admin opérationnel.
        </p>
    </div>
{% endblock %}
