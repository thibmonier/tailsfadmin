{% extends '@Tailsfadmin/layout/admin.html.twig' %}

{% block title %}Tarifs — tailsfadmin{% endblock %}
{% block breadcrumb %}<twig:tsf:Layout:Breadcrumb pageName="Tarifs" />{% endblock %}

{% block content %}
    <div class="mx-auto max-w-5xl">
        <div class="mb-8 text-center">
            <h2 class="text-title-sm font-bold text-gray-800 dark:text-white/90">Des tarifs simples et transparents</h2>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Choisissez le plan adapté à votre équipe.</p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {% for plan in plans %}
                <div
                    data-testid="pricing-plan"
                    class="relative overflow-hidden rounded-2xl border bg-white p-6 dark:bg-white/[0.03] {{ plan.popular ? 'border-brand-500 shadow-theme-md' : 'border-gray-200 dark:border-gray-800' }}"
                >
                    {% if plan.popular %}
                        <twig:tsf:Ui:Ribbon text="Populaire" variant="brand" position="top-right" />
                    {% endif %}
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">{{ plan.name }}</h3>
                    <p class="mt-3"><span class="text-title-md font-bold text-gray-800 dark:text-white/90">{{ plan.price }}</span><span class="text-sm text-gray-500 dark:text-gray-400"> / mois</span></p>
                    <ul class="mt-5 space-y-2">
                        {% for feature in plan.features %}
                            <li class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                                <svg class="size-4 text-success-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
                                {{ feature }}
                            </li>
                        {% endfor %}
                    </ul>
                    <button type="button" class="mt-6 inline-flex h-11 w-full items-center justify-center rounded-lg text-sm font-medium transition {{ plan.popular ? 'bg-brand-500 text-white hover:bg-brand-600' : 'border border-gray-300 text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/[0.03]' }}">Choisir {{ plan.name }}</button>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
