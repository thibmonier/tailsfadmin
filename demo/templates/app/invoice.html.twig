{% extends '@Tailsfadmin/layout/admin.html.twig' %}

{% block title %}Facture {{ invoice.number }} — tailsfadmin{% endblock %}
{% block breadcrumb %}<twig:tsf:Layout:Breadcrumb pageName="Facture" />{% endblock %}

{% block content %}
    <div class="mx-auto max-w-3xl" data-testid="invoice">
        <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03] md:p-8">
            <div class="flex flex-wrap items-start justify-between gap-4 border-b border-gray-100 pb-6 dark:border-gray-800">
                <div>
                    <span class="font-outfit text-2xl font-bold text-brand-500">tailsfadmin</span>
                    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{{ invoice.from }}</p>
                </div>
                <div class="text-right">
                    <h2 class="text-title-sm font-bold text-gray-800 dark:text-white/90">Facture</h2>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ invoice.number }}</p>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Émise le {{ invoice.date }}</p>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Échéance {{ invoice.due }}</p>
                </div>
            </div>

            <div class="py-6">
                <p class="text-theme-xs uppercase text-gray-400">Facturé à</p>
                <p class="mt-1 font-medium text-gray-800 dark:text-white/90">{{ invoice.to }}</p>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full text-left text-sm">
                    <thead>
                        <tr class="border-y border-gray-100 text-theme-xs text-gray-500 dark:border-gray-800 dark:text-gray-400">
                            <th class="py-3 font-medium">Description</th>
                            <th class="py-3 text-center font-medium">Qté</th>
                            <th class="py-3 text-right font-medium">P.U.</th>
                            <th class="py-3 text-right font-medium">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in invoice.lines %}
                            <tr class="border-b border-gray-100 dark:border-gray-800">
                                <td class="py-3 text-gray-800 dark:text-white/90">{{ line.label }}</td>
                                <td class="py-3 text-center text-gray-500 dark:text-gray-400">{{ line.qty }}</td>
                                <td class="py-3 text-right text-gray-500 dark:text-gray-400">{{ line.unit }}</td>
                                <td class="py-3 text-right text-gray-800 dark:text-white/90">{{ line.total }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-6 flex justify-end">
                <dl class="w-full max-w-xs space-y-2 text-sm">
                    <div class="flex justify-between"><dt class="text-gray-500 dark:text-gray-400">Sous-total</dt><dd class="text-gray-800 dark:text-white/90">{{ invoice.subtotal }}</dd></div>
                    <div class="flex justify-between"><dt class="text-gray-500 dark:text-gray-400">TVA (20 %)</dt><dd class="text-gray-800 dark:text-white/90">{{ invoice.tax }}</dd></div>
                    <div class="flex justify-between border-t border-gray-200 pt-2 dark:border-gray-800"><dt class="font-semibold text-gray-800 dark:text-white/90">Total</dt><dd class="font-bold text-gray-800 dark:text-white/90">{{ invoice.total }}</dd></div>
                </dl>
            </div>
        </div>

        <div class="mt-4 flex justify-end gap-3 print:hidden">
            <button type="button" onclick="window.print()" class="inline-flex h-11 items-center gap-2 rounded-lg border border-gray-300 px-5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/[0.03]">Imprimer</button>
            <button type="button" class="inline-flex h-11 items-center gap-2 rounded-lg bg-brand-500 px-5 text-sm font-medium text-white hover:bg-brand-600">Télécharger le PDF</button>
        </div>
    </div>
{% endblock %}
