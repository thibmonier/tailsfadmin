{% extends '@Tailsfadmin/layout/admin.html.twig' %}

{% block title %}Boîte de réception — tailsfadmin{% endblock %}
{% block breadcrumb %}<twig:tsf:Layout:Breadcrumb pageName="Boîte de réception" />{% endblock %}

{% block content %}
    <div data-testid="inbox" class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        {# Liste des e-mails #}
        <aside class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between border-b border-gray-100 p-4 dark:border-gray-800">
                <h2 class="text-sm font-semibold text-gray-800 dark:text-white/90">Réception</h2>
                <twig:tsf:Ui:Badge color="brand" size="sm">2 non lus</twig:tsf:Ui:Badge>
            </div>
            <ul class="divide-y divide-gray-100 dark:divide-gray-800">
                {% for mail in emails %}
                    <li>
                        <button type="button" data-testid="inbox-item" class="flex w-full flex-col gap-1 p-4 text-left transition hover:bg-gray-50 dark:hover:bg-white/[0.03] {{ mail.active ? 'bg-gray-50 dark:bg-white/[0.05]' : '' }}">
                            <div class="flex items-center justify-between">
                                <span class="text-sm {{ mail.unread ? 'font-semibold text-gray-800 dark:text-white/90' : 'text-gray-600 dark:text-gray-400' }}">{{ mail.from }}</span>
                                <span class="text-theme-xs text-gray-400">{{ mail.time }}</span>
                            </div>
                            <span class="text-sm {{ mail.unread ? 'font-medium text-gray-700 dark:text-gray-200' : 'text-gray-500 dark:text-gray-400' }}">{{ mail.subject }}</span>
                            <span class="truncate text-theme-sm text-gray-400">{{ mail.preview }}</span>
                        </button>
                    </li>
                {% endfor %}
            </ul>
        </aside>

        {# Volet de lecture #}
        <section class="rounded-2xl border border-gray-200 bg-white p-6 lg:col-span-2 dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center gap-3 border-b border-gray-100 pb-4 dark:border-gray-800">
                <twig:tsf:Ui:Avatar alt="Alice Dupont" size="md" />
                <div class="flex-1">
                    <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Compte-rendu de réunion</h3>
                    <p class="text-theme-sm text-gray-500 dark:text-gray-400">Alice Dupont &lt;alice@exemple.fr&gt; · 09:24</p>
                </div>
            </div>
            <div class="prose-sm mt-4 space-y-3 text-sm text-gray-600 dark:text-gray-400">
                <p>Bonjour,</p>
                <p>Voici les points abordés ce matin : périmètre du sprint, priorisation du backlog et planning de la revue. Le compte-rendu complet est en pièce jointe.</p>
                <p>Bonne journée,<br>Alice</p>
            </div>
            <div class="mt-6 flex gap-3">
                <button type="button" class="inline-flex h-11 items-center rounded-lg bg-brand-500 px-5 text-sm font-medium text-white hover:bg-brand-600">Répondre</button>
                <button type="button" class="inline-flex h-11 items-center rounded-lg border border-gray-300 px-5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/[0.03]">Transférer</button>
            </div>
        </section>
    </div>
{% endblock %}
