{% extends 'base.html.twig' %}

{#
  T-TECH-03 — Galerie UI Kit (/ui-kit)
  Sprint 3 : vitrine des composants US-008, US-009, US-010.
  Sert de cible pour les tests fonctionnels (AlertTest, BadgeAvatarTest, ButtonTest).
#}

{% block title %}UI Kit — tailsfadmin{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 p-8 dark:bg-gray-900">
    <div class="mx-auto max-w-4xl space-y-12">

        <header>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Galerie UI Kit</h1>
            <p class="mt-2 text-gray-500 dark:text-gray-400">Sprint 3 — Composants tsf:Ui:*</p>
        </header>

        {# ─── US-008 : Alerts ──────────────────────────────────────────────────── #}
        <section>
            <h2 class="mb-4 text-xl font-semibold text-gray-800 dark:text-white">Alerts (US-008)</h2>
            <div class="space-y-3">
                <twig:tsf:Ui:Alert type="success" title="Succès" message="L'opération a été réalisée avec succès." />
                <twig:tsf:Ui:Alert type="info" title="Information" message="Voici une information importante à retenir." />
                <twig:tsf:Ui:Alert type="warning" title="Attention" message="Cette action peut avoir des conséquences inattendues." />
                <twig:tsf:Ui:Alert type="error" title="Erreur" message="Une erreur est survenue. Veuillez réessayer." />
                <twig:tsf:Ui:Alert type="success" title="Dismissible" message="Cliquez sur × pour fermer cette alerte." :dismissible="true" />
            </div>
        </section>

        {# ─── US-009 : Badges ────────────────────────────────────────────────── #}
        <section>
            <h2 class="mb-4 text-xl font-semibold text-gray-800 dark:text-white">Badges (US-009)</h2>
            <div class="flex flex-wrap gap-3">
                <twig:tsf:Ui:Badge color="primary">Primary</twig:tsf:Ui:Badge>
                <twig:tsf:Ui:Badge color="success">Success</twig:tsf:Ui:Badge>
                <twig:tsf:Ui:Badge color="error">Error</twig:tsf:Ui:Badge>
                <twig:tsf:Ui:Badge color="warning">Warning</twig:tsf:Ui:Badge>
                <twig:tsf:Ui:Badge color="info">Info</twig:tsf:Ui:Badge>
                <twig:tsf:Ui:Badge color="light">Light</twig:tsf:Ui:Badge>
                <twig:tsf:Ui:Badge color="dark">Dark</twig:tsf:Ui:Badge>
            </div>
            <div class="mt-3 flex flex-wrap gap-3">
                <twig:tsf:Ui:Badge color="primary" size="sm">Primary SM</twig:tsf:Ui:Badge>
                <twig:tsf:Ui:Badge color="success" size="sm">Success SM</twig:tsf:Ui:Badge>
            </div>
        </section>

        {# ─── US-009 : Avatars ───────────────────────────────────────────────── #}
        <section>
            <h2 class="mb-4 text-xl font-semibold text-gray-800 dark:text-white">Avatars (US-009)</h2>

            {# Avatars avec image #}
            <div class="mb-4 flex items-end gap-4">
                <twig:tsf:Ui:Avatar src="https://ui-avatars.com/api/?name=Alice+Dupont&background=random" alt="Alice Dupont" size="xs" />
                <twig:tsf:Ui:Avatar src="https://ui-avatars.com/api/?name=Alice+Dupont&background=random" alt="Alice Dupont" size="sm" />
                <twig:tsf:Ui:Avatar src="https://ui-avatars.com/api/?name=Alice+Dupont&background=random" alt="Alice Dupont" size="md" />
                <twig:tsf:Ui:Avatar src="https://ui-avatars.com/api/?name=Alice+Dupont&background=random" alt="Alice Dupont" size="lg" />
                <twig:tsf:Ui:Avatar src="https://ui-avatars.com/api/?name=Alice+Dupont&background=random" alt="Alice Dupont" size="xl" />
                <twig:tsf:Ui:Avatar src="https://ui-avatars.com/api/?name=Alice+Dupont&background=random" alt="Alice Dupont" size="2xl" />
            </div>

            {# Avatars initiales (sans image) #}
            <div class="mb-4 flex items-end gap-4">
                <twig:tsf:Ui:Avatar alt="Bob Martin" size="sm" />
                <twig:tsf:Ui:Avatar alt="Bob Martin" size="md" />
                <twig:tsf:Ui:Avatar alt="Bob Martin" size="lg" />
            </div>

            {# Avatars avec statut #}
            <div class="flex items-end gap-4">
                <twig:tsf:Ui:Avatar src="https://ui-avatars.com/api/?name=Carol&background=random" alt="Carol" size="md" status="online" />
                <twig:tsf:Ui:Avatar src="https://ui-avatars.com/api/?name=Dave&background=random" alt="Dave" size="md" status="offline" />
                <twig:tsf:Ui:Avatar alt="Eve Legrand" size="md" status="online" />
            </div>
        </section>

        {# ─── US-010 : Buttons ───────────────────────────────────────────────── #}
        <section>
            <h2 class="mb-4 text-xl font-semibold text-gray-800 dark:text-white">Buttons (US-010)</h2>

            {# 6 variantes #}
            <div class="mb-4 flex flex-wrap gap-3">
                <twig:tsf:Ui:Button variant="primary">Primary</twig:tsf:Ui:Button>
                <twig:tsf:Ui:Button variant="secondary">Secondary</twig:tsf:Ui:Button>
                <twig:tsf:Ui:Button variant="success">Success</twig:tsf:Ui:Button>
                <twig:tsf:Ui:Button variant="danger">Danger</twig:tsf:Ui:Button>
                <twig:tsf:Ui:Button variant="ghost">Ghost</twig:tsf:Ui:Button>
                <twig:tsf:Ui:Button variant="link">Link</twig:tsf:Ui:Button>
            </div>

            {# Taille lg #}
            <div class="mb-4 flex flex-wrap gap-3">
                <twig:tsf:Ui:Button variant="primary" size="lg">Primary LG</twig:tsf:Ui:Button>
                <twig:tsf:Ui:Button variant="secondary" size="lg">Secondary LG</twig:tsf:Ui:Button>
            </div>

            {# Href → rendu <a> #}
            <div class="mb-4 flex flex-wrap gap-3">
                <twig:tsf:Ui:Button variant="primary" href="/">Lien (href)</twig:tsf:Ui:Button>
            </div>

            {# État loading #}
            <div class="mb-4 flex flex-wrap gap-3">
                <twig:tsf:Ui:Button variant="primary" :loading="true">Chargement…</twig:tsf:Ui:Button>
                <twig:tsf:Ui:Button variant="secondary" :loading="true">En cours…</twig:tsf:Ui:Button>
            </div>

            {# État disabled #}
            <div class="flex flex-wrap gap-3">
                <twig:tsf:Ui:Button variant="primary" :disabled="true">Désactivé</twig:tsf:Ui:Button>
                <twig:tsf:Ui:Button variant="secondary" :disabled="true">Désactivé</twig:tsf:Ui:Button>
            </div>
        </section>

        {# ─── US-012 : Dropdowns ─────────────────────────────────────────────── #}
        <section>
            <h2 class="mb-4 text-xl font-semibold text-gray-800 dark:text-white">Dropdowns (US-012)</h2>
            <div class="flex flex-wrap gap-6">

                {# Dropdown simple aligné à gauche #}
                <twig:tsf:Ui:Dropdown align="left">
                    <twig:block name="trigger">
                        <button
                            type="button"
                            class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-theme-xs ring-1 ring-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-700"
                            data-action="click->tailsfadmin--dropdown#toggle"
                        >
                            Options
                            <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/>
                            </svg>
                        </button>
                    </twig:block>
                    <twig:block name="menu">
                        <a href="#" role="menuitem" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">Modifier</a>
                        <a href="#" role="menuitem" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">Dupliquer</a>
                        <hr class="my-1 border-gray-100 dark:border-gray-700">
                        <a href="#" role="menuitem" class="flex items-center px-4 py-2 text-sm text-error-600 hover:bg-error-50 dark:text-error-400 dark:hover:bg-error-500/10">Supprimer</a>
                    </twig:block>
                </twig:tsf:Ui:Dropdown>

                {# Dropdown aligné à droite #}
                <twig:tsf:Ui:Dropdown align="right">
                    <twig:block name="trigger">
                        <button
                            type="button"
                            class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600"
                            data-action="click->tailsfadmin--dropdown#toggle"
                        >
                            Actions
                            <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/>
                            </svg>
                        </button>
                    </twig:block>
                    <twig:block name="menu">
                        <button type="button" role="menuitem" class="flex w-full items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">Exporter CSV</button>
                        <button type="button" role="menuitem" class="flex w-full items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">Imprimer</button>
                    </twig:block>
                </twig:tsf:Ui:Dropdown>

            </div>
        </section>

        {# ─── US-011 : Modals ────────────────────────────────────────────────── #}
        <section>
            <h2 class="mb-4 text-xl font-semibold text-gray-800 dark:text-white">Modals (US-011)</h2>
            <div class="flex flex-wrap gap-4">

                {# Modale SM — le trigger est inclus comme slot dans le composant #}
                <twig:tsf:Ui:Modal size="sm" labelId="modal-sm-title">
                    <twig:block name="trigger">
                        <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-4 py-3 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600">
                            Ouvrir modale SM
                        </button>
                    </twig:block>
                    <twig:block name="header">
                        <h3 id="modal-sm-title" class="text-lg font-semibold text-gray-800 dark:text-white">Confirmation</h3>
                    </twig:block>
                    <twig:block name="body">
                        <p>Êtes-vous sûr de vouloir effectuer cette action ? Cette opération est irréversible.</p>
                    </twig:block>
                    <twig:block name="footer">
                        <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-error-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-error-600" data-action="click->tailsfadmin--modal#close">Supprimer</button>
                        <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2.5 text-sm font-medium text-gray-700 ring-1 ring-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-400 dark:ring-gray-700" data-action="click->tailsfadmin--modal#close">Annuler</button>
                    </twig:block>
                </twig:tsf:Ui:Modal>

                {# Modale LG #}
                <twig:tsf:Ui:Modal size="lg" labelId="modal-lg-title">
                    <twig:block name="trigger">
                        <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-3 text-sm font-medium text-gray-700 shadow-theme-xs ring-1 ring-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-400 dark:ring-gray-700">
                            Ouvrir modale LG
                        </button>
                    </twig:block>
                    <twig:block name="header">
                        <h3 id="modal-lg-title" class="text-lg font-semibold text-gray-800 dark:text-white">Détails de l'élément</h3>
                    </twig:block>
                    <twig:block name="body">
                        <p>Contenu étendu de la modale. Peut contenir des formulaires, des tableaux, ou n'importe quel contenu riche. La taille max-w-2xl assure un espace généreux.</p>
                    </twig:block>
                    <twig:block name="footer">
                        <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-brand-600" data-action="click->tailsfadmin--modal#close">Valider</button>
                        <button type="button" class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-white/5" data-action="click->tailsfadmin--modal#close">Fermer</button>
                    </twig:block>
                </twig:tsf:Ui:Modal>

            </div>
        </section>

    </div>
</div>
{% endblock %}
