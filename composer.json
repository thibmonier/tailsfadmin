{
    "name": "tailsfadmin/tailsfadmin-bundle",
    "description": "Thème admin Symfony basé sur TailAdmin — bundle réutilisable (Symfony UX, Stimulus, AssetMapper)",
    "version": "0.1.0",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "symfony-ux",
        "admin",
        "theme",
        "tailwind"
    ],
    "authors": [
        {
            "name": "Thibaut Monier",
            "email": "thibaut.monier@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/ux-twig-component": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^12.2",
        "symfony/browser-kit": "^7.3 || ^8.0",
        "symfony/http-client": "^7.3 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Tailsfadmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tailsfadmin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
