{
    "name": "tailsfadmin/tailsfadmin-bundle",
    "description": "Thème admin Symfony basé sur TailAdmin — bundle réutilisable (Symfony UX, Stimulus, AssetMapper)",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/thibmonier/tailsfadmin",
    "support": {
        "issues": "https://github.com/thibmonier/tailsfadmin/issues",
        "source": "https://github.com/thibmonier/tailsfadmin"
    },
    "keywords": [
        "symfony",
        "symfony-ux",
        "stimulus",
        "admin",
        "dashboard",
        "theme",
        "tailwind",
        "tailadmin"
    ],
    "authors": [
        {
            "name": "Thibaut Monier",
            "email": "thibaut.monier@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "symfony/asset-mapper": "^7.3 || ^8.0",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/stimulus-bundle": "^2.20 || ^3.0",
        "symfony/translation": "^7.3 || ^8.0",
        "symfony/ux-twig-component": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^12.2",
        "symfony/browser-kit": "^7.3 || ^8.0",
        "symfony/http-client": "^7.3 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Tailsfadmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tailsfadmin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
