includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max

    # Valide la compatibilité sur toute la plage PHP supportée (composer.json : >=8.2),
    # même quand l'analyse tourne sur une version plus récente.
    phpVersion:
        min: 80200
        max: 80500

    paths:
        - src

    # Chemins à exclure de l'analyse
    excludePaths:
        - vendor/
