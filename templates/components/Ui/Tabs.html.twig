{#
  Composant Tabs — tsf:Ui:Tabs
  US-036 : onglets accessibles (pattern ARIA), pilotés par tailsfadmin--tabs.
  Les panneaux sont des blocs nommés par l'id d'onglet.

  Utilisation :
    <twig:tsf:Ui:Tabs :items="[{id:'profil',label:'Profil'},{id:'secu',label:'Sécurité'}]">
      <twig:block name="profil">Contenu profil</twig:block>
      <twig:block name="secu">Contenu sécurité</twig:block>
    </twig:tsf:Ui:Tabs>
#}

{%- set activeId = this.activeId() -%}

{%- set listConfig = {
    underline: 'flex gap-1 border-b border-gray-200 dark:border-gray-800',
    segmented: 'flex flex-wrap gap-1 rounded-lg bg-gray-100 p-1.5 dark:bg-gray-900',
    pill:      'inline-flex gap-1 rounded-lg bg-gray-100 p-1 dark:bg-gray-800',
    boxed:     'flex gap-1 border-b border-gray-200 dark:border-gray-800'
} -%}

{%- set tabBase = 'text-theme-sm inline-flex items-center gap-2 px-3 py-2 font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500' -%}

{%- set tabStates = {
    underline: {
        active:   '-mb-px border-b-2 border-brand-500 text-brand-500',
        inactive: '-mb-px border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200'
    },
    segmented: {
        active:   'rounded-md bg-white text-gray-900 shadow-theme-xs dark:bg-gray-800 dark:text-white',
        inactive: 'rounded-md text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200'
    },
    pill: {
        active:   'rounded-md bg-white text-brand-500 shadow-theme-xs dark:bg-gray-900',
        inactive: 'rounded-md text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200'
    },
    boxed: {
        active:   '-mb-px rounded-t-lg border border-b-transparent border-gray-200 bg-white text-brand-500 dark:border-gray-800 dark:bg-gray-900',
        inactive: 'text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200'
    }
} -%}

{%- set states = tabStates[variant] ?? tabStates['underline'] -%}
{%- set listClasses = listConfig[variant] ?? listConfig['underline'] -%}

<div
    data-controller="tailsfadmin--tabs"
    data-tailsfadmin--tabs-active-value="{{ activeId }}"
>
    <div role="tablist" class="{{ listClasses }}">
        {% for item in items %}
            {%- set isActive = item.id == activeId -%}
            <button
                type="button"
                role="tab"
                id="tsf-tab-{{ item.id }}"
                aria-controls="tsf-panel-{{ item.id }}"
                aria-selected="{{ isActive ? 'true' : 'false' }}"
                tabindex="{{ isActive ? '0' : '-1' }}"
                data-tailsfadmin--tabs-target="tab"
                data-tab-id="{{ item.id }}"
                data-action="tailsfadmin--tabs#select keydown->tailsfadmin--tabs#navigate"
                class="{{ tabBase }} {{ isActive ? states.active : states.inactive }}"
            >
                {%- if item.icon is defined and item.icon -%}
                    <span class="[&_svg]:h-4 [&_svg]:w-4" aria-hidden="true">{{ tsf_icon(item.icon) }}</span>
                {%- endif -%}
                {{ item.label }}
            </button>
        {% endfor %}
    </div>

    <div class="mt-4">
        {% for item in items %}
            {%- set isActive = item.id == activeId -%}
            <div
                role="tabpanel"
                id="tsf-panel-{{ item.id }}"
                aria-labelledby="tsf-tab-{{ item.id }}"
                data-tailsfadmin--tabs-target="panel"
                data-tab-id="{{ item.id }}"
                tabindex="0"
                {{ isActive ? '' : 'hidden' }}
            >
                {% if block(item.id) is defined %}{{ block(item.id) }}{% endif %}
            </div>
        {% endfor %}
    </div>
</div>
