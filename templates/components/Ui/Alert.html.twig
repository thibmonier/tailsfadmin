{#
  Composant Alert — tsf:Ui:Alert
  US-008 : 4 variantes + dismissible via Stimulus "tailsfadmin--alert-dismiss".
  Toutes les valeurs utilisateur sont auto-échappées par Twig (pas de |raw).
#}

{%- set typeConfig = {
    success: {
        wrapper: 'border-success-500 bg-success-50 dark:border-success-500/30 dark:bg-success-500/15',
        icon_color: 'text-success-500',
        title_color: 'text-gray-800 dark:text-white/90',
        message_color: 'text-gray-500 dark:text-gray-400',
        icon: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" fill="currentColor"/></svg>'
    },
    info: {
        wrapper: 'border-blue-light-500 bg-blue-light-50 dark:border-blue-light-500/30 dark:bg-blue-light-500/15',
        icon_color: 'text-blue-light-500',
        title_color: 'text-gray-800 dark:text-white/90',
        message_color: 'text-gray-500 dark:text-gray-400',
        icon: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" fill="currentColor"/></svg>'
    },
    warning: {
        wrapper: 'border-warning-500 bg-warning-50 dark:border-warning-500/30 dark:bg-warning-500/15',
        icon_color: 'text-warning-500 dark:text-orange-400',
        title_color: 'text-gray-800 dark:text-white/90',
        message_color: 'text-gray-500 dark:text-gray-400',
        icon: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" fill="currentColor"/></svg>'
    },
    error: {
        wrapper: 'border-error-500 bg-error-50 dark:border-error-500/30 dark:bg-error-500/15',
        icon_color: 'text-error-500',
        title_color: 'text-gray-800 dark:text-white/90',
        message_color: 'text-gray-500 dark:text-gray-400',
        icon: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" fill="currentColor"/></svg>'
    }
} -%}

{%- set config = typeConfig[type] ?? typeConfig['info'] -%}

<div
    class="rounded-xl border p-4 {{ config.wrapper }}"
    role="alert"
    {% if dismissible %}data-controller="tailsfadmin--alert-dismiss"{% endif %}
>
    <div class="flex items-start gap-3">
        {# Icône de variante #}
        <div class="-mt-0.5 shrink-0 {{ config.icon_color }}">
            {{ config.icon|raw }}
        </div>

        {# Contenu principal #}
        <div class="flex-1">
            {% if title %}
                <h4 class="mb-1 text-sm font-semibold {{ config.title_color }}">{{ title }}</h4>
            {% endif %}
            {% if message %}
                <p class="text-sm {{ config.message_color }}">{{ message }}</p>
            {% endif %}
        </div>

        {# Bouton de fermeture (mode dismissible uniquement) #}
        {% if dismissible %}
            <button
                type="button"
                class="-mt-0.5 shrink-0 text-gray-400 transition hover:text-gray-700 dark:text-gray-500 dark:hover:text-gray-300"
                data-action="click->tailsfadmin--alert-dismiss#dismiss"
                aria-label="Fermer l'alerte"
            >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M3.293 3.293a1 1 0 011.414 0L8 6.586l3.293-3.293a1 1 0 111.414 1.414L9.414 8l3.293 3.293a1 1 0 01-1.414 1.414L8 9.414l-3.293 3.293a1 1 0 01-1.414-1.414L6.586 8 3.293 4.707a1 1 0 010-1.414z"
                        fill="currentColor"
                    />
                </svg>
            </button>
        {% endif %}
    </div>
</div>
