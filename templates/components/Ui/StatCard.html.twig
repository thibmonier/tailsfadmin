{#
  Composant StatCard — tsf:Ui:StatCard
  Gap G1 (US-087) : carte KPI (icône + label + valeur) + delta/trend + progression optionnels.
  Icône fournie via le slot `icon` (SVG libre).

  Utilisation :
    <twig:tsf:Ui:StatCard label="Heures cette semaine" value="21,5 h">
        <twig:block name="icon">…svg…</twig:block>
    </twig:tsf:Ui:StatCard>
    <twig:tsf:Ui:StatCard label="Complétude" value="80 %" :progress="80" variant="warning" />
#}

{%- set slotIcon %}{% block icon %}{% endblock %}{% endset -%}
{%- set pct = this.percent() -%}

{%- set iconConfig = {
    brand:   'bg-brand-50 text-brand-500 dark:bg-brand-500/15',
    success: 'bg-success-50 text-success-500 dark:bg-success-500/15',
    warning: 'bg-warning-50 text-warning-500 dark:bg-warning-500/15',
    error:   'bg-error-50 text-error-500 dark:bg-error-500/15'
} -%}
{%- set barConfig = {
    brand:   'bg-brand-500',
    success: 'bg-success-500',
    warning: 'bg-warning-500',
    error:   'bg-error-500'
} -%}
{%- set trendConfig = {
    up:      'text-success-600 dark:text-success-500',
    down:    'text-error-600 dark:text-error-500',
    neutral: 'text-gray-500 dark:text-gray-400'
} -%}

{%- set iconClass  = iconConfig[variant]  ?? iconConfig['brand']  -%}
{%- set barClass   = barConfig[variant]   ?? barConfig['brand']   -%}
{%- set trendClass = trendConfig[trend]   ?? trendConfig['neutral'] -%}

{%- set tag = href ? 'a' : 'div' -%}

<{{ tag }}
    {% if href %}href="{{ href }}"{% endif %}
    class="block rounded-2xl border border-gray-200 bg-white p-5 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]{% if href %} transition-colors hover:border-brand-300 dark:hover:border-brand-500{% endif %}"
    {{ attributes }}
>
    <div class="flex items-center justify-between">
        {%- if slotIcon|trim %}
            <span class="flex h-11 w-11 items-center justify-center rounded-xl {{ iconClass }}" aria-hidden="true">
                {{ slotIcon }}
            </span>
        {%- endif %}
        {%- if delta is not null %}
            <span class="text-theme-sm font-medium {{ trendClass }}">{{ delta|e }}</span>
        {%- endif %}
    </div>

    <div class="{% if slotIcon|trim or delta is not null %}mt-4{% endif %}">
        {%- if label %}
            <span class="text-theme-sm text-gray-500 dark:text-gray-400">{{ label|e }}</span>
        {%- endif %}
        <h4 class="mt-1 text-title-sm font-bold text-gray-800 dark:text-white/90">{{ value|e }}</h4>
    </div>

    {%- if pct is not null %}
        <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-gray-800"
             role="progressbar" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100"
             {% if label %}aria-label="{{ label|e }}"{% endif %}>
            <div class="h-full rounded-full {{ barClass }} transition-[width] duration-300" style="width: {{ pct }}%"></div>
        </div>
    {%- endif %}

    {%- if hint is not null %}
        <p class="mt-2 text-theme-xs text-gray-500 dark:text-gray-400">{{ hint|e }}</p>
    {%- endif %}
</{{ tag }}>
