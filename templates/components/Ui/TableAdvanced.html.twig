{#
  Composant Table avancée — tsf:Ui:TableAdvanced
  US-017 :
    - Colonne de sélection (checkbox .tableCheckbox) avec « tout sélectionner »
    - Indicateurs de tri (icônes) dans les en-têtes
    - Dropdown d'actions par ligne : réutilise data-controller="tailsfadmin--dropdown" (US-007/012)
    - Cellules riches : tsf:Ui:Avatar (nom/rôle), tsf:Ui:Badge (statut)
  Aucun Alpine.js.
#}

{%- set badgeMap = {
    'active': {color: 'success', label: 'Actif'},
    'pending': {color: 'warning', label: 'En attente'},
    'cancel': {color: 'error', label: 'Annulé'},
} -%}

<div class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]" data-testid="table-advanced">
    {%- if title is not empty -%}
        <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800 sm:px-6">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">{{ title }}</h3>
        </div>
    {%- endif -%}

    <div class="max-w-full overflow-x-auto">
        <table class="min-w-full">
            {# ── En-têtes ─────────────────────────────────────────────────── #}
            <thead>
                <tr class="border-b border-gray-100 dark:border-gray-800">
                    {# Colonne sélection tout #}
                    <th class="px-5 py-3 sm:px-6">
                        <label class="flex cursor-pointer select-none items-center gap-2">
                            <input type="checkbox" class="tableCheckbox sr-only peer" id="select-all-{{ random() }}" />
                            <span class="relative flex h-5 w-5 items-center justify-center rounded border-2 border-gray-300 bg-white peer-checked:border-brand-500 peer-checked:bg-brand-500 dark:border-gray-600 dark:bg-gray-800">
                                <span class="opacity-0 peer-checked:opacity-100">
                                    <svg class="h-3 w-3 fill-white" viewBox="0 0 12 12" aria-hidden="true">
                                        <path d="M10 3L5 8L2 5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                    </svg>
                                </span>
                            </span>
                        </label>
                    </th>
                    {# En-tête Utilisateur avec indicateur de tri #}
                    <th class="px-5 py-3 text-left sm:px-6">
                        <button type="button" class="flex items-center gap-1 text-theme-xs font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                            Utilisateur
                            <svg class="h-3.5 w-3.5 stroke-current" viewBox="0 0 14 14" fill="none" aria-label="Trier" aria-hidden="true">
                                <path d="M7 2v10M3.5 6L7 2l3.5 4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </th>
                    {# En-tête Projet avec indicateur de tri #}
                    <th class="px-5 py-3 text-left sm:px-6">
                        <button type="button" class="flex items-center gap-1 text-theme-xs font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                            Projet
                            <svg class="h-3.5 w-3.5 stroke-current" viewBox="0 0 14 14" fill="none" aria-label="Trier" aria-hidden="true">
                                <path d="M7 2v10M3.5 6L7 2l3.5 4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </th>
                    <th class="px-5 py-3 text-left sm:px-6">
                        <p class="text-theme-xs font-medium text-gray-500 dark:text-gray-400">Statut</p>
                    </th>
                    <th class="px-5 py-3 text-left sm:px-6">
                        <p class="text-theme-xs font-medium text-gray-500 dark:text-gray-400">Budget</p>
                    </th>
                    <th class="px-5 py-3 sm:px-6">
                        <span class="sr-only">Actions</span>
                    </th>
                </tr>
            </thead>

            {# ── Corps ────────────────────────────────────────────────────── #}
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                {%- for row in rows -%}
                {%- set badge = badgeMap[row.status] ?? {color: 'light', label: row.status} -%}
                <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                    {# Checkbox de ligne #}
                    <td class="px-5 py-4 sm:px-6">
                        <label class="flex cursor-pointer select-none items-center">
                            <input type="checkbox" class="tableCheckbox sr-only peer" />
                            <span class="relative flex h-5 w-5 items-center justify-center rounded border-2 border-gray-300 bg-white peer-checked:border-brand-500 peer-checked:bg-brand-500 dark:border-gray-600 dark:bg-gray-800">
                                <span class="opacity-0 peer-checked:opacity-100">
                                    <svg class="h-3 w-3" viewBox="0 0 12 12" aria-hidden="true">
                                        <path d="M10 3L5 8L2 5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                    </svg>
                                </span>
                            </span>
                        </label>
                    </td>

                    {# Avatar + Nom + Rôle #}
                    <td class="px-5 py-4 sm:px-6">
                        <div class="flex items-center gap-3">
                            <twig:tsf:Ui:Avatar alt="{{ row.name }}" size="sm" />
                            <div>
                                <span class="block text-theme-sm font-medium text-gray-800 dark:text-white/90">{{ row.name }}</span>
                                <span class="block text-theme-xs text-gray-500 dark:text-gray-400">{{ row.role }}</span>
                            </div>
                        </div>
                    </td>

                    {# Projet #}
                    <td class="px-5 py-4 sm:px-6">
                        <p class="text-theme-sm text-gray-500 dark:text-gray-400">{{ row.project }}</p>
                    </td>

                    {# Statut (Badge) #}
                    <td class="px-5 py-4 sm:px-6">
                        <twig:tsf:Ui:Badge color="{{ badge.color }}" size="sm">{{ badge.label }}</twig:tsf:Ui:Badge>
                    </td>

                    {# Budget #}
                    <td class="px-5 py-4 sm:px-6">
                        <p class="text-theme-sm text-gray-500 dark:text-gray-400">{{ row.budget }}</p>
                    </td>

                    {# Dropdown d'actions — réutilise data-controller="tailsfadmin--dropdown" #}
                    <td class="px-5 py-4 sm:px-6">
                        <div
                            class="relative inline-block"
                            data-controller="tailsfadmin--dropdown"
                            data-testid="table-action-dropdown"
                        >
                            <button
                                type="button"
                                data-tailsfadmin--dropdown-target="trigger"
                                data-action="click->tailsfadmin--dropdown#toggle"
                                aria-expanded="false"
                                class="flex h-8 w-8 items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-white/[0.05] dark:hover:text-gray-300"
                                aria-label="Actions pour {{ row.name }}"
                            >
                                <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                                    <circle cx="10" cy="4" r="1.5"/>
                                    <circle cx="10" cy="10" r="1.5"/>
                                    <circle cx="10" cy="16" r="1.5"/>
                                </svg>
                            </button>

                            <div
                                data-tailsfadmin--dropdown-target="menu"
                                data-action="keydown->tailsfadmin--dropdown#navigate"
                                role="menu"
                                aria-orientation="vertical"
                                hidden
                                class="absolute right-0 z-50 mt-2 min-w-[10rem] rounded-xl border border-gray-200 bg-white py-1 shadow-lg dark:border-gray-700 dark:bg-gray-800"
                            >
                                <a
                                    role="menuitem"
                                    href="#"
                                    class="block px-4 py-2 text-theme-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/[0.05]"
                                >
                                    Voir
                                </a>
                                <a
                                    role="menuitem"
                                    href="#"
                                    class="block px-4 py-2 text-theme-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/[0.05]"
                                >
                                    Modifier
                                </a>
                                <a
                                    role="menuitem"
                                    href="#"
                                    class="block px-4 py-2 text-theme-sm text-error-600 hover:bg-error-50 dark:text-error-400 dark:hover:bg-error-500/10"
                                >
                                    Supprimer
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
                {%- else -%}
                <tr>
                    <td colspan="6" class="px-5 py-8 text-center text-theme-sm text-gray-400 dark:text-gray-500">
                        Aucune donnée à afficher.
                    </td>
                </tr>
                {%- endfor -%}
            </tbody>
        </table>
    </div>
</div>
