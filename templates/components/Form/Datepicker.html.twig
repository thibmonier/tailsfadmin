{#
  Composant Datepicker — tsf:Form:Datepicker
  US-015 : input stylé TailAdmin + contrôleur tailsfadmin--datepicker (flatpickr vendoré).
  Aucun Alpine.js. Aucun CDN runtime.

  Le contrôleur reçoit ses options via data-*-value (Stimulus values API).
  Le CSS flatpickr est chargé par AssetMapper (importmap.php, type: css).
#}

<div class="space-y-1.5">
    {%- if label is not empty -%}
    <label for="{{ id }}" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
        {{ label }}
    </label>
    {%- endif -%}

    <div class="relative">
        {# Icône calendrier (pointer-events-none) #}
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4" aria-hidden="true">
            <svg class="h-5 w-5 fill-gray-500 dark:fill-gray-400" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M6.66683 1.54199C7.08104 1.54199 7.41683 1.87778 7.41683 2.29199V3.00033H12.5835V2.29199C12.5835 1.87778 12.9193 1.54199 13.3335 1.54199C13.7477 1.54199 14.0835 1.87778 14.0835 2.29199V3.00033L15.4168 3.00033C16.5214 3.00033 17.4168 3.89576 17.4168 5.00033V7.50033V15.8337C17.4168 16.9382 16.5214 17.8337 15.4168 17.8337H4.5835C3.47893 17.8337 2.5835 16.9382 2.5835 15.8337V7.50033V5.00033C2.5835 3.89576 3.47893 3.00033 4.5835 3.00033L5.91683 3.00033V2.29199C5.91683 1.87778 6.25262 1.54199 6.66683 1.54199ZM6.66683 4.50033H4.5835C4.30735 4.50033 4.0835 4.72418 4.0835 5.00033V6.75033H15.9168V5.00033C15.9168 4.72418 15.693 4.50033 15.4168 4.50033H13.3335H6.66683ZM15.9168 8.25033H4.0835V15.8337C4.0835 16.1098 4.30735 16.3337 4.5835 16.3337H15.4168C15.693 16.3337 15.9168 16.1098 15.9168 15.8337V8.25033Z"/>
            </svg>
        </div>

        <input
            type="text"
            id="{{ id }}"
            name="{{ name }}"
            value="{{ value }}"
            placeholder="{{ placeholder }}"
            {%- if disabled %} disabled{% endif %}
            autocomplete="off"
            class="h-11 w-full rounded-lg border border-gray-300 bg-transparent py-2.5 pl-11 pr-4 text-sm font-medium text-gray-700 shadow-theme-xs placeholder:text-gray-400 focus:border-brand-300 focus:ring-3 focus:ring-brand-500/10 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800"
            data-controller="tailsfadmin--datepicker"
            data-tailsfadmin--datepicker-mode-value="{{ mode }}"
            data-tailsfadmin--datepicker-date-format-value="{{ dateFormat }}"
            data-tailsfadmin--datepicker-enable-time-value="{{ enableTime ? 'true' : 'false' }}"
        />
    </div>
</div>
