{#
  Composant InputGroup — tsf:Form:InputGroup
  US-014 : champ avec préfixe/suffixe (icônes, texte, boutons).

  Utilisation :
    <twig:tsf:Form:InputGroup label="Site web" name="url" type="url">
        <twig:block name="prefix">
            <span class="input-group-prefix flex items-center px-3 text-gray-500">https://</span>
        </twig:block>
    </twig:tsf:Form:InputGroup>
#}

{%- set slotPrefix %}{% block prefix %}{% endblock %}{% endset -%}
{%- set slotSuffix %}{% block suffix %}{% endblock %}{% endset -%}

{%- set baseClass = 'h-11 w-full bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30' -%}

{%- if error %}
    {%- set stateClass = 'border-error-300 focus:border-error-300 focus:ring-error-500/10 dark:border-error-700 dark:focus:border-error-800' -%}
{%- elseif success %}
    {%- set stateClass = 'border-success-300 focus:border-success-300 focus:ring-success-500/10 dark:border-success-700 dark:focus:border-success-800' -%}
{%- else %}
    {%- set stateClass = 'border-gray-300 focus:border-brand-300 focus:ring-brand-500/10 dark:border-gray-700 dark:focus:border-brand-800' -%}
{%- endif %}

{%- set disabledClass = disabled ? 'cursor-not-allowed opacity-70' : '' -%}

<div {{ attributes }}>
    {%- if label %}
        <label for="{{ id }}" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
            {{- label|e -}}
        </label>
    {%- endif %}

    <div class="flex items-center rounded-lg border shadow-theme-xs {{ stateClass }} {{ disabledClass }} overflow-hidden">
        {%- if slotPrefix|trim %}
            <div class="input-group-prefix flex shrink-0 items-center border-r border-gray-300 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
                {{ slotPrefix }}
            </div>
        {%- endif %}

        <input
            type="{{ type }}"
            id="{{ id }}"
            name="{{ name }}"
            class="{{ baseClass }} flex-1 border-0 focus:ring-0"
            {% if value %}value="{{ value|e }}"{% endif %}
            {% if placeholder %}placeholder="{{ placeholder|e }}"{% endif %}
            {% if disabled %}disabled{% endif %}
            {% if error %}aria-invalid="true" aria-describedby="{{ id }}-error"{% endif %}
        />

        {%- if slotSuffix|trim %}
            <div class="input-group-suffix flex shrink-0 items-center border-l border-gray-300 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
                {{ slotSuffix }}
            </div>
        {%- endif %}
    </div>

    {%- if error %}
        <p id="{{ id }}-error" class="form-error-message mt-1.5 text-sm text-error-500">{{ error|e }}</p>
    {%- endif %}
</div>
