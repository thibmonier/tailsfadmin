{#
  Composant Sidebar — tsf:Layout:Sidebar
  US-006 : sidebar responsive multi-niveaux, contrôleur Stimulus "tailsfadmin--sidebar".
  Groupes et items configurés via tailsfadmin.yaml (MenuBuilder).
  Classes ltr:/rtl: posées (anticipation RTL — ADR-005).
  Source : Tools/sources/tailadmin-free-tailwind-dashboard-template-main/src/partials/sidebar.html
#}
<aside
    data-tailsfadmin--sidebar-target="sidebar"
    class="sidebar fixed left-0 top-0 z-9999 flex h-screen w-[290px] flex-col overflow-y-hidden border-r border-gray-200 bg-white px-5 dark:border-gray-800 dark:bg-black ltr:left-0 rtl:right-0 lg:static lg:translate-x-0 -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
>
    {# En-tête sidebar : logo + bouton collapse desktop #}
    <div class="flex items-center justify-between gap-2 pt-8 pb-7 sidebar-header">
        <a href="{{ path('home') }}" aria-label="Accueil">
            <span class="font-outfit text-2xl font-bold text-brand-500">tailsfadmin</span>
        </a>

        {# Bouton collapse desktop — masqué sur mobile #}
        <button
            type="button"
            data-action="click->tailsfadmin--sidebar#toggle"
            class="hidden lg:flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white transition-colors"
            aria-label="Réduire le menu"
        >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M2.5 10C2.5 9.58579 2.83579 9.25 3.25 9.25H16.75C17.1642 9.25 17.5 9.58579 17.5 10C17.5 10.4142 17.1642 10.75 16.75 10.75H3.25C2.83579 10.75 2.5 10.4142 2.5 10Z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M2.5 5C2.5 4.58579 2.83579 4.25 3.25 4.25H16.75C17.1642 4.25 17.5 4.58579 17.5 5C17.5 5.41421 17.1642 5.75 16.75 5.75H3.25C2.83579 5.75 2.5 5.41421 2.5 5Z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M2.5 15C2.5 14.5858 2.83579 14.25 3.25 14.25H10.75C11.1642 14.25 11.5 14.5858 11.5 15C11.5 15.4142 11.1642 15.75 10.75 15.75H3.25C2.83579 15.75 2.5 15.4142 2.5 15Z" fill="currentColor"/>
            </svg>
        </button>
    </div>

    <div class="flex flex-col overflow-y-auto duration-300 ease-linear no-scrollbar">
        <nav aria-label="Menu principal">

            {% for group in this.groups %}
                <div class="mb-6">
                    <h3 class="mb-4 text-xs uppercase leading-[20px] text-gray-400">
                        {{ group.label }}
                    </h3>

                    <ul class="flex flex-col gap-4">
                        {% for item in group.items %}
                            <li>
                                {% set isActive = is_active(item.path) %}
                                {% set hasChildren = item.children|length > 0 %}

                                {% if hasChildren %}
                                    {# Item avec sous-menu #}
                                    <div x-data="{ open: {{ isActive ? 'true' : 'false' }} }">
                                        <button
                                            type="button"
                                            class="{{ isActive ? 'menu-item menu-item-active' : 'menu-item menu-item-inactive' }} group w-full"
                                            aria-expanded="{{ isActive ? 'true' : 'false' }}"
                                        >
                                            <span class="{{ isActive ? 'menu-item-icon-active' : 'menu-item-icon-inactive' }}">
                                                {{ tsf_icon(item.icon) }}
                                            </span>
                                            <span class="menu-item-text ltr:ml-2 rtl:mr-2">{{ item.label }}</span>
                                            {# Chevron #}
                                            <svg
                                                class="ml-auto transition-transform duration-200 {{ isActive ? 'rotate-180' : '' }}"
                                                width="16" height="16" viewBox="0 0 16 16"
                                                fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
                                            >
                                                <path fill-rule="evenodd" clip-rule="evenodd"
                                                    d="M3.4645 5.2981C3.72485 5.03774 4.14696 5.03774 4.40731 5.2981L8.00001 8.8908L11.5927 5.2981C11.8531 5.03775 12.2752 5.03775 12.5355 5.2981C12.7959 5.55845 12.7959 5.98056 12.5355 6.24091L8.47141 10.305C8.21106 10.5654 7.78895 10.5654 7.5286 10.305L3.4645 6.24091C3.20415 5.98056 3.20415 5.55845 3.4645 5.2981Z"
                                                    fill="currentColor"/>
                                            </svg>
                                        </button>

                                        {# Sous-menu #}
                                        <ul class="{{ isActive ? '' : 'hidden' }} mt-2 ml-6 flex flex-col gap-1 ltr:border-l rtl:border-r border-gray-200 dark:border-gray-700 pl-4">
                                            {% for child in item.children %}
                                                <li>
                                                    <a
                                                        href="{{ child.path }}"
                                                        class="{{ is_active(child.path) ? 'text-brand-500 font-medium' : 'text-gray-600 dark:text-gray-400' }} block py-1 text-sm hover:text-brand-500 dark:hover:text-white transition-colors ltr:text-left rtl:text-right"
                                                        {% if is_active(child.path) %}aria-current="page"{% endif %}
                                                    >
                                                        {{ child.label }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% else %}
                                    {# Item simple #}
                                    <a
                                        href="{{ item.path }}"
                                        class="{{ isActive ? 'menu-item menu-item-active' : 'menu-item menu-item-inactive' }} group"
                                        {% if isActive %}aria-current="page"{% endif %}
                                    >
                                        <span class="{{ isActive ? 'menu-item-icon-active' : 'menu-item-icon-inactive' }}">
                                            {{ tsf_icon(item.icon) }}
                                        </span>
                                        <span class="menu-item-text ltr:ml-2 rtl:mr-2">{{ item.label }}</span>
                                    </a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}

        </nav>
    </div>
</aside>
