{#
  Composant Header — tsf:Layout:Header
  US-007 : barre de recherche (Cmd/Ctrl+K, /), dropdown user-menu, dropdown notifications.
  US-006 : hamburger relié à tailsfadmin--sidebar#open.
  US-005 : bouton toggle tailsfadmin--theme.
  Source : Tools/sources/tailadmin-free-tailwind-dashboard-template-main/src/partials/header.html
#}
<header
    class="sticky top-0 z-99999 flex w-full border-gray-200 bg-white lg:border-b dark:border-gray-800 dark:bg-gray-900"
>
    <div class="flex grow items-center justify-between px-3 py-3 lg:px-6 lg:py-4 gap-2 sm:gap-4">

        {# ─── Gauche : hamburger mobile ───────────────────────────────────── #}
        <div class="flex items-center gap-2 lg:gap-0">
            {# Hamburger — ouvre le drawer mobile (US-006, tailsfadmin--sidebar) #}
            <button
                class="flex h-10 w-10 items-center justify-center rounded-lg border-gray-200 text-gray-500 lg:h-11 lg:w-11 lg:border dark:border-gray-800 dark:text-gray-400"
                aria-label="{{ 'chrome.menu_toggle'|trans }}"
                type="button"
                data-action="click->tailsfadmin--sidebar#open"
            >
                <svg
                    class="fill-current"
                    width="16"
                    height="12"
                    viewBox="0 0 16 12"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >
                    <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M0.583252 1C0.583252 0.585788 0.919038 0.25 1.33325 0.25H14.6666C15.0808 0.25 15.4166 0.585786 15.4166 1C15.4166 1.41421 15.0808 1.75 14.6666 1.75L1.33325 1.75C0.919038 1.75 0.583252 1.41422 0.583252 1ZM0.583252 11C0.583252 10.5858 0.919038 10.25 1.33325 10.25L14.6666 10.25C15.0808 10.25 15.4166 10.5858 15.4166 11C15.4166 11.4142 15.0808 11.75 14.6666 11.75L1.33325 11.75C0.919038 11.75 0.583252 11.4142 0.583252 11ZM1.33325 5.25C0.919038 5.25 0.583252 5.58579 0.583252 6C0.583252 6.41421 0.919038 6.75 1.33325 6.75L7.99992 6.75C8.41413 6.75 8.74992 6.41421 8.74992 6C8.74992 5.58579 8.41413 5.25 7.99992 5.25L1.33325 5.25Z"
                        fill=""
                    />
                </svg>
            </button>

            {# Logo mobile #}
            <a href="{{ path('home') }}" class="lg:hidden" aria-label="{{ 'chrome.home'|trans }}">
                <span class="font-outfit text-lg font-bold text-brand-500">tailsfadmin</span>
            </a>
        </div>

        {# ─── Centre : barre de recherche (US-007) ────────────────────────── #}
        <div
            class="hidden lg:flex flex-1 max-w-lg"
            data-controller="tailsfadmin--search"
        >
            <div class="relative w-full">
                {# Icône loupe #}
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M3.75 8.25C3.75 5.76472 5.76472 3.75 8.25 3.75C10.7353 3.75 12.75 5.76472 12.75 8.25C12.75 10.7353 10.7353 12.75 8.25 12.75C5.76472 12.75 3.75 10.7353 3.75 8.25ZM8.25 2.25C4.93629 2.25 2.25 4.93629 2.25 8.25C2.25 11.5637 4.93629 14.25 8.25 14.25C9.66289 14.25 10.9635 13.769 11.9952 12.9596L14.7678 15.7322C15.0607 16.0251 15.5355 16.0251 15.8284 15.7322C16.1213 15.4393 16.1213 14.9645 15.8284 14.6716L13.0558 11.899C13.8649 10.8674 14.25 9.59289 14.25 8.25C14.25 4.93629 11.5637 2.25 8.25 2.25Z" fill="currentColor"/>
                    </svg>
                </span>

                <input
                    type="search"
                    id="search-input"
                    placeholder="{{ 'chrome.search.placeholder'|trans }}"
                    class="w-full rounded-lg border border-gray-200 bg-gray-50 py-2 pl-10 pr-4 text-sm text-gray-700 placeholder-gray-400 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:placeholder-gray-600 dark:focus:border-brand-500"
                    aria-label="{{ 'chrome.search.label'|trans }}"
                    data-tailsfadmin--search-target="input"
                    data-action="keydown->tailsfadmin--search#handleEscape"
                    autocomplete="off"
                />

                {# Hint raccourcis #}
                <span class="absolute right-3 top-1/2 -translate-y-1/2 hidden sm:flex items-center gap-1 text-xs text-gray-400 dark:text-gray-600 pointer-events-none" aria-hidden="true">
                    <kbd class="rounded border border-gray-200 bg-white px-1 dark:border-gray-700 dark:bg-gray-900">Ctrl</kbd>
                    <kbd class="rounded border border-gray-200 bg-white px-1 dark:border-gray-700 dark:bg-gray-900">K</kbd>
                </span>
            </div>
        </div>

        {# ─── Droite : actions ────────────────────────────────────────────── #}
        <div class="flex items-center gap-2">

            {# Bouton recherche mobile #}
            <button
                type="button"
                class="flex lg:hidden h-10 w-10 items-center justify-center rounded-lg border border-gray-200 text-gray-500 dark:border-gray-800 dark:text-gray-400"
                aria-label="{{ 'chrome.search.label'|trans }}"
            >
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M3.75 8.25C3.75 5.76472 5.76472 3.75 8.25 3.75C10.7353 3.75 12.75 5.76472 12.75 8.25C12.75 10.7353 10.7353 12.75 8.25 12.75C5.76472 12.75 3.75 10.7353 3.75 8.25ZM8.25 2.25C4.93629 2.25 2.25 4.93629 2.25 8.25C2.25 11.5637 4.93629 14.25 8.25 14.25C9.66289 14.25 10.9635 13.769 11.9952 12.9596L14.7678 15.7322C15.0607 16.0251 15.5355 16.0251 15.8284 15.7322C16.1213 15.4393 16.1213 14.9645 15.8284 14.6716L13.0558 11.899C13.8649 10.8674 14.25 9.59289 14.25 8.25C14.25 4.93629 11.5637 2.25 8.25 2.25Z" fill="currentColor"/>
                </svg>
            </button>

            {# Bouton toggle dark/clair — contrôleur Stimulus "tailsfadmin--theme" (US-005) #}
            <button
                type="button"
                data-controller="tailsfadmin--theme"
                data-action="click->tailsfadmin--theme#toggle"
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:border-gray-800 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                aria-label="{{ 'chrome.toggle_theme'|trans }}"
            >
                {# Icône soleil — visible en mode sombre (dark:block), masquée en clair #}
                <svg class="hidden dark:block fill-current" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9.99998 1.5415C10.4142 1.5415 10.75 1.87729 10.75 2.2915V3.5415C10.75 3.95572 10.4142 4.2915 9.99998 4.2915C9.58577 4.2915 9.24998 3.95572 9.24998 3.5415V2.2915C9.24998 1.87729 9.58577 1.5415 9.99998 1.5415ZM10.0009 6.79327C8.22978 6.79327 6.79402 8.22904 6.79402 10.0001C6.79402 11.7712 8.22978 13.207 10.0009 13.207C11.772 13.207 13.2078 11.7712 13.2078 10.0001C13.2078 8.22904 11.772 6.79327 10.0009 6.79327ZM5.29402 10.0001C5.29402 7.40061 7.40135 5.29327 10.0009 5.29327C12.6004 5.29327 14.7078 7.40061 14.7078 10.0001C14.7078 12.5997 12.6004 14.707 10.0009 14.707C7.40135 14.707 5.29402 12.5997 5.29402 10.0001ZM15.9813 5.08035C16.2742 4.78746 16.2742 4.31258 15.9813 4.01969C15.6884 3.7268 15.2135 3.7268 14.9207 4.01969L14.0368 4.90357C13.7439 5.19647 13.7439 5.67134 14.0368 5.96423C14.3297 6.25713 14.8045 6.25713 15.0974 5.96423L15.9813 5.08035ZM18.4577 10.0001C18.4577 10.4143 18.1219 10.7501 17.7077 10.7501H16.4577C16.0435 10.7501 15.7077 10.4143 15.7077 10.0001C15.7077 9.58592 16.0435 9.25013 16.4577 9.25013H17.7077C18.1219 9.25013 18.4577 9.58592 18.4577 10.0001ZM14.9207 15.9806C15.2135 16.2735 15.6884 16.2735 15.9813 15.9806C16.2742 15.6877 16.2742 15.2128 15.9813 14.9199L15.0974 14.036C14.8045 13.7431 14.3297 13.7431 14.0368 14.036C13.7439 14.3289 13.7439 14.8038 14.0368 15.0967L14.9207 15.9806ZM9.99998 15.7088C10.4142 15.7088 10.75 16.0445 10.75 16.4588V17.7088C10.75 18.123 10.4142 18.4588 9.99998 18.4588C9.58577 18.4588 9.24998 18.123 9.24998 17.7088V16.4588C9.24998 16.0445 9.58577 15.7088 9.99998 15.7088ZM5.96356 15.0972C6.25646 14.8043 6.25646 14.3295 5.96356 14.0366C5.67067 13.7437 5.1958 13.7437 4.9029 14.0366L4.01902 14.9204C3.72613 15.2133 3.72613 15.6882 4.01902 15.9811C4.31191 16.274 4.78679 16.274 5.07968 15.9811L5.96356 15.0972ZM4.29224 10.0001C4.29224 10.4143 3.95645 10.7501 3.54224 10.7501H2.29224C1.87802 10.7501 1.54224 10.4143 1.54224 10.0001C1.54224 9.58592 1.87802 9.25013 2.29224 9.25013H3.54224C3.95645 9.25013 4.29224 9.58592 4.29224 10.0001ZM4.9029 5.9637C5.1958 6.25659 5.67067 6.25659 5.96356 5.9637C6.25646 5.6708 6.25646 5.19593 5.96356 4.90303L5.07968 4.01915C4.78679 3.72626 4.31191 3.72626 4.01902 4.01915C3.72613 4.31204 3.72613 4.78692 4.01902 5.07981L4.9029 5.9637Z" fill="currentColor"/>
                </svg>
                {# Icône lune — visible en mode clair (block), masquée en sombre (dark:hidden) #}
                <svg class="block dark:hidden fill-current" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M17.4547 11.97L18.1799 12.1611C18.265 11.8383 18.1265 11.4982 17.8401 11.3266C17.5538 11.1551 17.1885 11.1934 16.944 11.4207L17.4547 11.97ZM8.0306 2.5459L8.57989 3.05657C8.80718 2.81209 8.84554 2.44682 8.67398 2.16046C8.50243 1.8741 8.16227 1.73559 7.83948 1.82066L8.0306 2.5459ZM12.9154 13.0035C9.64678 13.0035 6.99707 10.3538 6.99707 7.08524H5.49707C5.49707 11.1823 8.81835 14.5035 12.9154 14.5035V13.0035ZM16.944 11.4207C15.8869 12.4035 14.4721 13.0035 12.9154 13.0035V14.5035C14.8657 14.5035 16.6418 13.7499 17.9654 12.5193L16.944 11.4207ZM16.7295 11.7789C15.9437 14.7607 13.2277 16.9586 10.0003 16.9586V18.4586C13.9257 18.4586 17.2249 15.7853 18.1799 12.1611L16.7295 11.7789ZM10.0003 16.9586C6.15734 16.9586 3.04199 13.8433 3.04199 10.0003H1.54199C1.54199 14.6717 5.32892 18.4586 10.0003 18.4586V16.9586ZM3.04199 10.0003C3.04199 6.77289 5.23988 4.05695 8.22173 3.27114L7.83948 1.82066C4.21532 2.77574 1.54199 6.07486 1.54199 10.0003H3.04199ZM6.99707 7.08524C6.99707 5.52854 7.5971 4.11366 8.57989 3.05657L7.48132 2.03522C6.25073 3.35885 5.49707 5.13487 5.49707 7.08524H6.99707Z" fill="currentColor"/>
                </svg>
            </button>

            {# ─── Sélecteur de langue (US-024) — réutilise tsf:Ui:Dropdown ─── #}
            <twig:tsf:Ui:Dropdown align="right">
                <twig:block name="trigger">
                    <button
                        type="button"
                        class="flex h-10 items-center gap-1.5 rounded-lg border border-gray-200 px-2.5 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:border-gray-800 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                        aria-label="{{ 'chrome.language.label'|trans }}"
                        aria-haspopup="true"
                    >
                        {% for l in tsf_locales() %}{% if l.current %}<span class="text-base leading-none" aria-hidden="true">{{ l.flag }}</span><span class="hidden text-sm font-medium uppercase sm:inline">{{ l.code }}</span>{% endif %}{% endfor %}
                    </button>
                </twig:block>
                <twig:block name="menu">
                    {% for l in tsf_locales() %}
                        <a
                            href="{{ path('locale_switch', {locale: l.code}) }}"
                            role="menuitem"
                            hreflang="{{ l.code }}"
                            class="flex items-center gap-2.5 px-4 py-2 text-sm transition-colors focus:outline-none {{ l.current ? 'font-medium text-brand-500' : 'text-gray-700 dark:text-gray-300' }} hover:bg-gray-50 dark:hover:bg-gray-700 focus:bg-gray-50 dark:focus:bg-gray-700"
                            {% if l.current %}aria-current="true"{% endif %}
                        >
                            <span class="text-base leading-none" aria-hidden="true">{{ l.flag }}</span>
                            <span>{{ l.native }}</span>
                        </a>
                    {% endfor %}
                </twig:block>
            </twig:tsf:Ui:Dropdown>

            {# ─── Dropdown notifications (US-007) ─────────────────────────── #}
            <div
                class="relative"
                data-controller="tailsfadmin--dropdown"
            >
                <button
                    type="button"
                    class="relative flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:border-gray-800 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                    aria-label="{{ 'chrome.notifications.label'|trans }}"
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-tailsfadmin--dropdown-target="trigger"
                    data-action="click->tailsfadmin--dropdown#toggle"
                >
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M10 2C7.23858 2 5 4.23858 5 7V9.5L3.5 11V13H16.5V11L15 9.5V7C15 4.23858 12.7614 2 10 2ZM10 18C8.89543 18 8 17.1046 8 16H12C12 17.1046 11.1046 18 10 18Z" fill="currentColor"/>
                    </svg>
                    {# Badge compteur #}
                    <span class="absolute -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-brand-500 text-[10px] font-bold text-white ltr:-right-1 rtl:-left-1" aria-label="{{ 'chrome.notifications.label'|trans }}">3</span>
                </button>

                {# Panneau notifications #}
                <div
                    data-tailsfadmin--dropdown-target="menu"
                    data-action="keydown->tailsfadmin--dropdown#navigate"
                    role="menu"
                    aria-label="{{ 'chrome.notifications.label'|trans }}"
                    hidden
                    class="absolute ltr:right-0 rtl:left-0 top-full mt-2 w-80 rounded-xl border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-900 z-50"
                >
                    <div class="border-b border-gray-100 px-4 py-3 dark:border-gray-800">
                        <h3 class="text-sm font-semibold text-gray-900 dark:text-white">{{ 'chrome.notifications.title'|trans }}</h3>
                    </div>
                    <ul class="divide-y divide-gray-100 dark:divide-gray-800 max-h-80 overflow-y-auto">
                        <li>
                            <a href="#" role="menuitem" class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors focus:outline-none focus:bg-gray-50 dark:focus:bg-gray-800">
                                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-500 dark:bg-brand-900">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="currentColor" opacity=".2"/><circle cx="8" cy="8" r="3" fill="currentColor"/></svg>
                                </span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate">{{ 'chrome.notifications.n1_title'|trans }}</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{ 'chrome.notifications.n1_time'|trans }}</p>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="#" role="menuitem" class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors focus:outline-none focus:bg-gray-50 dark:focus:bg-gray-800">
                                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-success-50 text-success-500 dark:bg-success-900">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate">{{ 'chrome.notifications.n2_title'|trans }}</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{ 'chrome.notifications.n2_time'|trans }}</p>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="#" role="menuitem" class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors focus:outline-none focus:bg-gray-50 dark:focus:bg-gray-800">
                                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-warning-50 text-warning-500 dark:bg-warning-900">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 5v4M8 11.5v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M2 12L8 2l6 10H2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                                </span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate">{{ 'chrome.notifications.n3_title'|trans }}</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{ 'chrome.notifications.n3_time'|trans }}</p>
                                </div>
                            </a>
                        </li>
                    </ul>
                    <div class="border-t border-gray-100 px-4 py-2.5 dark:border-gray-800">
                        <a href="#" role="menuitem" class="block text-center text-xs font-medium text-brand-500 hover:text-brand-600 dark:text-brand-400 focus:outline-none">
                            {{ 'chrome.notifications.view_all'|trans }}
                        </a>
                    </div>
                </div>
            </div>

            {# ─── Dropdown user-menu (US-007) ─────────────────────────────── #}
            <div
                class="relative"
                data-controller="tailsfadmin--dropdown"
            >
                <button
                    type="button"
                    class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-gray-200 bg-gray-100 text-gray-600 transition-colors hover:border-brand-400 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
                    aria-label="{{ 'chrome.user.menu_label'|trans }}"
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-tailsfadmin--dropdown-target="trigger"
                    data-action="click->tailsfadmin--dropdown#toggle"
                >
                    <span class="text-sm font-semibold" aria-hidden="true">A</span>
                </button>

                {# Panneau user-menu #}
                <div
                    data-tailsfadmin--dropdown-target="menu"
                    data-action="keydown->tailsfadmin--dropdown#navigate"
                    role="menu"
                    aria-label="{{ 'chrome.user.menu_label'|trans }}"
                    hidden
                    class="absolute ltr:right-0 rtl:left-0 top-full mt-2 w-56 rounded-xl border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-900 z-50"
                >
                    {# Infos utilisateur #}
                    <div class="border-b border-gray-100 px-4 py-3 dark:border-gray-800">
                        <p class="text-sm font-semibold text-gray-900 dark:text-white">{{ 'chrome.user.name'|trans }}</p>
                        <p class="truncate text-xs text-gray-500 dark:text-gray-400">{{ 'chrome.user.email'|trans }}</p>
                    </div>

                    <ul class="py-1.5">
                        <li>
                            <a
                                href="#"
                                role="menuitem"
                                class="flex items-center gap-2.5 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white transition-colors focus:outline-none focus:bg-gray-50 dark:focus:bg-gray-800"
                            >
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8 2C6.34315 2 5 3.34315 5 5C5 6.65685 6.34315 8 8 8C9.65685 8 11 6.65685 11 5C11 3.34315 9.65685 2 8 2ZM6.5 5C6.5 4.17157 7.17157 3.5 8 3.5C8.82843 3.5 9.5 4.17157 9.5 5C9.5 5.82843 8.82843 6.5 8 6.5C7.17157 6.5 6.5 5.82843 6.5 5ZM3.5 13C3.5 11.0706 5.57081 9.5 8 9.5C10.4292 9.5 12.5 11.0706 12.5 13H3.5Z" fill="currentColor"/></svg>
                                {{ 'chrome.user.profile'|trans }}
                            </a>
                        </li>
                        <li>
                            <a
                                href="#"
                                role="menuitem"
                                class="flex items-center gap-2.5 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white transition-colors focus:outline-none focus:bg-gray-50 dark:focus:bg-gray-800"
                            >
